# ─── Supabase ───────────────────────────────────────────────────────────────
# Used by DOS HUB + Onboarding to read/write tenants and leads.
# Production (Vercel): use these exact names only (no typos; trim values in the dashboard if pasted with spaces):
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
# Invalid or placeholder values are ignored so the app does not crash — fix env in Vercel if persistence is required.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ─────────────────────────────────────────────────────────────────
# DOS uses Stripe Checkout for subscription sign-ups. Each plan in
# app/lib/stripe.ts maps to a Stripe Price via STRIPE_PRICE_<PLAN_ID>.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://directiveos.com

# Contact page (Formspree). Required for /contact form submissions in production.
NEXT_PUBLIC_FORMSPREE_CONTACT_ACTION=https://formspree.io/f/xzdolvll

# ─── GHL Start Here CRM integration ────────────────────────────────────────────
# Server-only. Never prefix these variables with NEXT_PUBLIC_.
# Private Integration Token scope required: contacts.write.
GHL_PRIVATE_INTEGRATION_TOKEN=pit-...
GHL_LOCATION_ID=...
# Optional opportunity sync. Both values are required to enable it, along with
# opportunities.readonly and opportunities.write token scopes.
GHL_DOS_PIPELINE_ID=...
GHL_DOS_PIPELINE_STAGE_ID=...
# Optional; applied alongside the mandatory "DOS — Start Here Submitted" tag.
GHL_START_HERE_LEAD_SOURCE_TAG=DOS — Lead Source — Start Here
# Optional JSON map of Start Here fields to existing GHL Contact custom-field IDs.
# Missing or invalid mappings never prevent the standard contact handoff.
GHL_START_HERE_CUSTOM_FIELD_MAP={"businessType":"...","mainChallenge":"...","enquirySources":"...","missedMostOften":"...","workflowPainPoint":"...","firstFix":"...","bestTimeToCall":"...","sourcePage":"...","projectContext":"..."}

# Optional: hostname for admin subdomain (must match Vercel domain). Middleware redirects / → /command-centre.
# NEXT_PUBLIC_ADMIN_HOST=admin.directiveos.com.au

# Optional: COS/Micah web chat widget script URL for pages that embed MicahCosChatWidget (e.g. onboarding).
# NEXT_PUBLIC_MICAH_COS_CHAT_WIDGET_SCRIPT=https://...
